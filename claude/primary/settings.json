{
  "disableAllHooks": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "edi hook session-start" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "edi hook user-prompt-submit" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|AskUserQuestion",
        "hooks": [{ "type": "command", "command": "edi hook pre-tool-use" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "edi hook post-tool-use" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "edi hook stop" }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "edi hook stop-failure" }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "edi hook notification" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "edi hook session-end" }]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "edi statusline",
    "refreshInterval": 60
  }
}
