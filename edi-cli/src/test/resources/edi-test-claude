#!/bin/sh
set -u

launched_with="$*"
session=""
source="startup"
task_directory=""
prompt=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --session-id) session=$2; shift 2 ;;
        --resume) session=$2; source="resume"; shift 2 ;;
        --) prompt=$2; shift 2 ;;
        --dangerously-skip-permissions) shift ;;
        --add-dir)
            task_directory=$2
            shift
            while [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; do shift; done
            ;;
        --disallowedTools)
            shift
            while [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; do shift; done
            ;;
        *) shift 2 ;;
    esac
done
[ -z "$task_directory" ] || { printf '%s' "$launched_with" | tr '\n' ' '; echo; } >> "$task_directory/stub-launches.txt"
transcript="${task_directory:-$PWD}/stub-transcript-$session.jsonl"
context_full=""

json_string() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | awk 'BEGIN { ORS = "" } NR > 1 { print "\\n" } { print }'
}

hook() {
    printf '{"session_id":"%s","hook_event_name":"%s","cwd":"%s","transcript_path":"%s"%s}' "$session" "$1" "$(json_string "$PWD")" \
        "$(json_string "$transcript")" "$2" | edi hook "$3"
}

read_the_inbox() {
    edi inbox
    edi inbox | sed -n 's/^Message \([0-9][0-9]*\).*/\1/p' | while read -r number; do edi inbox ack "$number"; done
}

run_tool() {
    answer=$(hook PreToolUse ",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"$(json_string "$1")\"}" pre-tool-use)
    case "$answer" in
        *'"deny"'*) printf 'EDI refused: %s\n' "$1" ;;
        *) sh -c "$1" ;;
    esac
}

run_the_brief() {
    brief=${1#*brief waiting: read }
    brief=${brief% and follow it}
    commands=$(mktemp)
    sed -n 's/^stub-run: //p' "$brief" > "$commands"
    while IFS= read -r command; do run_tool "$command" < /dev/null; done < "$commands"
    rm -f "$commands"
    if grep -q '^stub-context: full$' "$brief"; then context_full=yes; fi
}

fill_the_context() {
    printf '{"type":"assistant","isApiErrorMessage":true,"error":"invalid_request","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]},"timestamp":"%s"}\n' \
        "Prompt is too long" "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" >> "$transcript"
}

stop() {
    answer=$(hook Stop ',"stop_hook_active":false' stop)
    case "$answer" in
        *'"block"'*) read_the_inbox; hook Stop ',"stop_hook_active":true' stop > /dev/null ;;
    esac
}

turn() {
    hook UserPromptSubmit ",\"prompt\":\"$(json_string "$1")\"" user-prompt-submit > /dev/null
    case "$1" in
        *"brief waiting: read "*) run_the_brief "$1" ;;
        *"waiting: run edi inbox"*) read_the_inbox ;;
    esac
    if [ -n "$context_full" ]; then fill_the_context; else stop; fi
}

show_the_idle_prompt() {
    printf '%s\n%s\n%s\n' "────────────────────" "❯" "────────────────────"
}

hook SessionStart ",\"source\":\"$source\"" session-start > /dev/null
turn "$prompt"
show_the_idle_prompt
while IFS= read -r line; do
    turn "$line"
    show_the_idle_prompt
done
